#Search for a number in the list
nums = [1,4,9,16,25,36,49,64,81,100]
x = int(input("Enter a number to search: "))
i = 0 
while i < len(nums):
    if nums[i] == x:
        print(f"Found {x} at index {i}")
        break
    else :
        print("finding.....")
    i += 1
    
print ("Search completed. ") 